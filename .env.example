GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Module 3 — RFP Sentinel Copilot (Groq account 1)
GROQ_API_KEY=your-groq-api-key

# Module 4 — Smart Content Reuse Engine (SEPARATE Groq account from Module 3)
# This key belongs to a different Groq account and must never be merged with
# or substituted for Module 3's key — the isolation ensures independent
# rate-limit budgets for the two modules.
GROQ_MODULE4_API_KEY=your-groq-module4-api-key
